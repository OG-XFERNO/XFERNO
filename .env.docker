# ==============================================
# XFERNO Docker Environment Variables
# ==============================================
# Copy this to .env and customize as needed

# Database
POSTGRES_USER=xferno
POSTGRES_PASSWORD=xferno_dev
POSTGRES_DB=xferno
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380
REDIS_PASSWORD=xferno_redis_dev

# API - Change API_PORT if 3002 is in use
API_PORT=3002
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Web - Change WEB_PORT if 3000 is in use
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3002

# Node
NODE_ENV=development

# Blockchain RPC URLs (Sepolia Testnet)
# Get your own API keys from Alchemy/Infura for production
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_WS_URL=wss://ethereum-sepolia-rpc.publicnode.com

# ==============================================
# ALTERNATIVE PORTS (if defaults are in use)
# ==============================================
# Uncomment and modify if you have port conflicts:
# WEB_PORT=4000
# API_PORT=4002
# POSTGRES_PORT=5434
# REDIS_PORT=6381

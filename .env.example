# ============================================
# XFERNO Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control

# ============================================
# Application
# ============================================
NODE_ENV=development
APP_NAME=XFERNO
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://xferno:xferno_dev@localhost:5432/xferno

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# DIDit OAuth (https://didit.me)
DIDIT_CLIENT_ID=
DIDIT_CLIENT_SECRET=
DIDIT_REDIRECT_URI=http://localhost:3000/auth/callback/didit

# ============================================
# Blockchain RPC Endpoints
# ============================================
# Ethereum
ETH_MAINNET_RPC=https://eth.llamarpc.com
ETH_SEPOLIA_RPC=https://rpc.sepolia.org

# BlockDAG
BDAG_MAINNET_RPC=https://rpc.blockdag.network
BDAG_TESTNET_RPC=https://testnet-rpc.blockdag.network

# L2s
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org
POLYGON_RPC=https://polygon-rpc.com
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
BNB_RPC=https://bsc-dataseed.binance.org

# Solana
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# ============================================
# Wallet / Signing Keys
# ============================================
# WARNING: Never commit real private keys!
# Use environment variables or a secrets manager in production
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# ============================================
# External Services
# ============================================
# Etherscan (for contract verification)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
SNOWTRACE_API_KEY=
BSCSCAN_API_KEY=

# Alchemy (optional, for better RPC)
ALCHEMY_API_KEY=

# The Graph (for indexing)
GRAPH_API_KEY=

# ============================================
# Frontend Public Variables
# ============================================
# These are exposed to the browser (prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME=XFERNO
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ============================================
# Feature Flags
# ============================================
ENABLE_ZK_MODE=true
ENABLE_SOLANA=false
ENABLE_GRADUATION=true
ENABLE_PRESALE=true

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=debug
SENTRY_DSN=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

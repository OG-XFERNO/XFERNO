# XFERNO Contract Deployment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED
# ============================================

# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# ============================================
# RPC ENDPOINTS
# ============================================

# Ethereum
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Base
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Other L2s
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# ============================================
# BLOCK EXPLORER API KEYS (for verification)
# ============================================

ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
OPTIMISTIC_ETHERSCAN_API_KEY=your_optimism_api_key

# ============================================
# OPTIONAL DEPLOYMENT CONFIGURATION
# ============================================

# Fee recipient address (defaults to deployer)
# FEE_RECIPIENT=0x...

# DEX factory for graduation (if available)
# DEX_FACTORY=0x...

# Token creation fee in wei (default: 0.001 ether for testnet)
# CREATION_FEE=1000000000000000

# Virtual ETH reserve (default: 30 ether)
# VIRTUAL_ETH=30000000000000000000

# Virtual token reserve (default: 1B tokens)
# VIRTUAL_TOKEN=1000000000000000000000000000

# Graduation threshold in wei (default: 69 ether)
# GRADUATION_THRESHOLD=69000000000000000000

# Platform fee in basis points (default: 100 = 1%)
# FEE_BPS=100
